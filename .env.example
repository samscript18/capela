# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_BASE_CHAIN_ID=84532
# Optional Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# API
MONGODB_URI=mongodb://127.0.0.1:27017/capela
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional SPKI public key. Leave empty to let the Privy SDK use its managed JWKS cache.
PRIVY_JWT_VERIFICATION_KEY=
# Server-side profile image storage. Never expose the API secret to the web app.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Scientific search
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TIMEOUT_MS=20000

# Gemini on Google Cloud. The simplest option is a Vertex AI Express Mode API key.
GOOGLE_CLOUD_API_KEY=
# Standard Google Cloud alternative: project + Application Default Credentials.
# Locally, set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file path.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=90000
GEMINI_MAX_OUTPUT_TOKENS=12000
GEMINI_THINKING_BUDGET=0

# Gemini fallback
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=90000
GROQ_EVIDENCE_BATCH_SIZE=1
GROQ_MAX_OUTPUT_TOKENS=4000
MAX_PAPER_TEXT_CHARS=12000
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
PUBCHEM_TIMEOUT_MS=10000
# Official PubChem Compound fallback through NCBI Entrez E-utilities.
NCBI_EUTILS_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# Optional: raises the NCBI E-utilities rate limit from 3 to 10 requests/second.
NCBI_API_KEY=
NCBI_EMAIL=
PAYMENTS_ENABLED=false
PAYMENT_RECEIVER_ADDRESS=
INVESTIGATION_PRICE_WEI=
BASE_CHAIN_ID=84532
BASE_RPC_URL=
BASE_MIN_CONFIRMATIONS=1
BASE_RECEIPT_TIMEOUT_MS=60000
MAX_DISCOVERED_PAPERS=35
MAX_ANALYZED_PAPERS=5
# Comma-separated when production and preview web origins both need API access.
WEB_ORIGIN=http://localhost:3000
PORT=4000

# Mozilla hosted path is the default. Only explicit legacy uses Gemini/Groq/Tavily.
RESEARCH_PROVIDER=otari
OTARI_BASE_URL=https://otari.ai/api/v1
OTARI_API_KEY=
# Reference to an owner-configured, finite hosted runtime-key spend ceiling (not an admin key).
OTARI_BUDGET_REFERENCE=
# Select policies from the real hosted catalog; verify distinct resolved IDs and model licenses.
OTARI_EXTRACTION_POLICY=
OTARI_REVIEW_POLICY=
OTARI_MCP_SERVER_ID=
# Zero disables paid runs. USD fixed-point micro-dollars, integer only.
OTARI_RUN_BUDGET_MICROUSD=0
# Conservative per-dispatch estimate; unreported costs retain their reservation.
OTARI_CALL_RESERVATION_MICROUSD=10000
# >=32 random characters, separate from the Otari key. Configure in hosted remote MCP headers.
CAPELA_MCP_TOKEN=
# Separate owner authorization for opt-in live verification; zero by default.
OTARI_LIVE_TEST_BUDGET_MICROUSD=0
# Optional paired held-out evaluation; human-check the source's molecule name first.
EVAL_SOURCE_ID=
EVAL_MOLECULE_NAME=
