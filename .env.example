# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_BASE_CHAIN_ID=84532
# Optional Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# API
MONGODB_URI=mongodb://127.0.0.1:27017/capela
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional SPKI public key. Leave empty to let the Privy SDK use its managed JWKS cache.
PRIVY_JWT_VERIFICATION_KEY=
# Server-side profile image storage. Never expose the API secret to the web app.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Scientific search
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TIMEOUT_MS=20000

# Gemini on Google Cloud. The simplest option is a Vertex AI Express Mode API key.
GOOGLE_CLOUD_API_KEY=
# Standard Google Cloud alternative: project + Application Default Credentials.
# Locally, set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file path.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=90000
GEMINI_MAX_OUTPUT_TOKENS=8000
# Gemini 3.8 Flash uses LOW thinking; older thinking-budget settings are not used.

# Gemini fallback
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=90000
GROQ_EVIDENCE_BATCH_SIZE=1
GROQ_MAX_OUTPUT_TOKENS=4000
MAX_PAPER_TEXT_CHARS=12000
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
PUBCHEM_TIMEOUT_MS=10000
# Official PubChem Compound fallback through NCBI Entrez E-utilities.
NCBI_EUTILS_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# Optional: raises the NCBI E-utilities rate limit from 3 to 10 requests/second.
NCBI_API_KEY=
NCBI_EMAIL=
PAYMENTS_ENABLED=false
PAYMENT_RECEIVER_ADDRESS=
INVESTIGATION_PRICE_WEI=
BASE_CHAIN_ID=84532
BASE_RPC_URL=
BASE_MIN_CONFIRMATIONS=1
BASE_RECEIPT_TIMEOUT_MS=60000
MAX_DISCOVERED_PAPERS=35
MAX_ANALYZED_PAPERS=5
# Comma-separated when production and preview web origins both need API access.
WEB_ORIGIN=http://localhost:3000
PORT=4000

# Hosted Otari research (default; no provider selector or base URL needed).
OTARI_API_KEY=
OTARI_EXTRACTION_POLICY=
# Optional explicit hybrid mode: vertex uses existing Google Cloud credentials/GEMINI_MODEL for review fallback.
# Direct Vertex usage is billed by Google, not Otari; unknown cost retains a $0.10 run reservation.
OTARI_REVIEW_FALLBACK=
OTARI_REVIEW_POLICY=
OTARI_MCP_SERVER_ID=
# Application run cap in integer USD micro-dollars. Zero disables paid runs.
# Also configure the actual finite key ceiling in hosted Otari.
OTARI_RUN_BUDGET_MICROUSD=0
# Separate >=32-character secret for Capela's authenticated remote MCP endpoint.
CAPELA_MCP_TOKEN=

# Optional bounded verification: per-run paid dispatch limit (default 16, maximum 24).
# OTARI_RUN_MAX_CALLS=5

# Optional isolated capability tests only; never substitute the normal runtime key.
# Also require verified nonsecret .local-evaluation/controlled-test-config.json metadata.
OTARI_ROUTING_TEST_API_KEY=
OTARI_CEILING_TEST_API_KEY=
